{
	"name": "WikiBag JSPWiki Share",
	"short_name": "WikiBag",
	"start_url": "./wikibag.html",
	"scope": ".",
	"lang": "en-US",
	"background_color": "#ECEFF1",	
	"display": "standalone",
	"share_target": {
		"action": "./wikibag",
		"method": "POST",
	    "enctype": "multipart/form-data",
	    "params": {
	      "title": "name",
	      "text": "description",
	      "url": "link",
	      "files": [
	        {
	          "name": "pdf",
	          "accept": ["application/pdf"]
	        },
	        {
	          "name": "png",
	          "accept": ["image/png"]
	        },
	        {
	          "name": "jpeg",
	          "accept": ["image/jpeg"]
	        },
	        {
	          "name": "webp",
	          "accept": ["image/webp"]
	        },
	        {
	          "name": "mp4",
	          "accept": ["video/mp4"]
	        }
	      ]
	    }
	}
}